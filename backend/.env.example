# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/amara-salon

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Admin (used once by the seed script to create the first admin account)
ADMIN_NAME=AMARA Admin
ADMIN_EMAIL=admin@amarabeauty.com
ADMIN_PASSWORD=ChangeMe123!

# Email notifications (Gmail example - use an App Password, not your real password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="AMARA Hair & Beauty <no-reply@amarabeauty.com>"
SALON_NOTIFY_EMAIL=admin@amarabeauty.com

# WhatsApp notifications
# Salon's WhatsApp number, international format, no + or spaces (used to build a wa.me deep link
# and shown to the customer/admin after a booking is made — needs no paid API to work).
SALON_WHATSAPP_NUMBER=27821234567

# OPTIONAL: Twilio WhatsApp Business API — if you fill these in, the server will also
# auto-send the WhatsApp message instead of just generating the link. Leave blank to skip.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
